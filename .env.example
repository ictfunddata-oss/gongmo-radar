# 이 파일을 .env 로 복사해 값을 채운다. 경로는 절대경로 또는 프로젝트 루트 기준 상대경로.

# ── Claude API (공고 분류·표준 필드 추출, ADR-045) ──
# API 키는 .env 에만 둔다(.env 는 git 제외). 코드·로그·커밋에 넣지 않는다
CLAUDE_API=
# 모델 ID는 하이픈 표기(claude-sonnet-5-5)다. 점 표기(claude-sonnet-5.5)는 모델 ID가 아니다
CLAUDE_MODEL=claude-sonnet-5-5
# effort: low / medium / high. 분류 프롬프트는 low로 검증했다(plan/01 5장). 올리면 비용·시간이 늘어난다
CLAUDE_MODEL_EFFORT=low

# ── 저장 경로 ──
DATA_DIR=./data
# DB_PATH=./data/gongmo.db
# 첨부파일 저장 위치 — 임시 경로를 지정하려면 여기를 바꾼다 (예: D:/gongmo_attachments)
ATTACHMENT_DIR=./data/attachments
# EXPORT_DIR=./data/exports
# LEGACY_DB_PATH=./archive/legacy_nipa/data/nipa.db

# ── 수집 ──
CRAWL_DELAY=0.3
# 수집 전에 사이트의 robots.txt 를 확인한다(1=확인, 0=건너뜀). 확인할 수 없거나 막혀 있으면 그 실행은 수집하지 않는다
ROBOTS_CHECK=1
DOWNLOAD_ATTACHMENTS=1
ATTACH_MAX_MB=200

# ── 수요자 화면 ──
# 접수 마감 공고를 기본으로 보여 줄지(1/0). 운영 때는 0을 권장
PUBLIC_SHOW_ENDED=1

# ── Flask ──
SECRET_KEY=change-me

# ── 관리자 로그인 ──
# 비밀번호는 직접 적지 않고 `flask --app run set-admin-password` 로 설정한다(해시만 아래 줄에 저장됨).
# ADMIN_ID=admin
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_HOURS=8
# https 로 배포할 때는 true 로 바꾼다
# ADMIN_COOKIE_SECURE=false
